# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env git'e gitmez (.gitignore içinde).

# Sunucu tarafı — sadece /api/chat içinde kullanılır, tarayıcıya gitmez.
# VITE_ öneki KOYMA: Vite, VITE_ ile başlayan her değişkeni build sırasında
# istemci paketine gömer ve herkes tarafından okunabilir hale getirir.
GEMINI_KEY=

# İstemci tarafı — Google Maps gömülü haritası için gerekli, tarayıcıya gider.
# Bu normaldir, ama Google Cloud Console'da mutlaka HTTP referrer kısıtlaması
# tanımla (yalnızca kendi alan adın çalışsın).
VITE_GOOGLE_MAPS_KEY=
